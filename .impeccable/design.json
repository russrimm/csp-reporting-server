  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action button for empty states and decisive actions.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Copy headers</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);background:var(--text);color:var(--bg);font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 120ms,border-color 120ms,color 120ms}.ds-btn-primary:hover{background:var(--text-2)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis toolbar action with icon and text.",
      "html": "<button class=\"ds-btn-ghost\" type=\"button\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M2.75 3.25h10.5M2.75 8h10.5M2.75 12.75h6.5\"/></svg><span>Dashboard</span></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);background:transparent;color:var(--text-2);font:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 120ms,color 120ms}.ds-btn-ghost svg{width:14px;height:14px;flex:none}.ds-btn-ghost:hover{background:var(--surface-2);color:var(--text)}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Dashboard report search with leading icon and keyboard hint.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.75\"/><path d=\"m10.5 10.5 3.25 3.25\"/></svg><input class=\"ds-input\" type=\"search\" placeholder=\"Search URLs, directives, apps…\"><kbd>/</kbd></label>",
      "css": ".ds-search{position:relative;display:block;width:min(420px,100%);color:var(--text-3)}.ds-search svg{position:absolute;top:50%;left:9px;width:14px;height:14px;transform:translateY(-50%);pointer-events:none}.ds-input{width:100%;height:30px;padding:0 32px 0 30px;border:1px solid var(--border-strong);border-radius:var(--radius);background:var(--surface);color:var(--text);font:inherit;font-size:13px}.ds-input::placeholder{color:var(--text-3)}.ds-input:focus-visible{outline:none;border-color:var(--focus);box-shadow:0 0 0 3px color-mix(in srgb,var(--focus) 22%,transparent)}.ds-search kbd{position:absolute;top:50%;right:7px;min-width:18px;height:18px;padding:0 4px;border:1px solid var(--border-strong);border-bottom-width:2px;border-radius:var(--radius-sm);color:var(--text-3);font:11px/16px var(--font-mono);text-align:center;transform:translateY(-50%)}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segmented-control",
      "description": "Small mode/disposition selector with a tonal active item.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Disposition\"><button aria-pressed=\"true\">All</button><button aria-pressed=\"false\">Enforced</button><button aria-pressed=\"false\">Report-only</button></div>",
      "css": ".ds-segmented{display:inline-flex;padding:2px;border:1px solid var(--border-strong);border-radius:var(--radius);background:var(--surface-2)}.ds-segmented button{height:24px;padding:0 10px;border:0;border-radius:var(--radius-sm);background:transparent;color:var(--text-2);font:inherit;font-size:12px;font-weight:500;line-height:24px;cursor:pointer}.ds-segmented button:hover{color:var(--text)}.ds-segmented [aria-pressed=\"true\"]{background:var(--surface);color:var(--text);box-shadow:0 1px 2px rgb(0 0 0 / .08),0 0 0 1px var(--border)}.ds-segmented button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Disposition Pills",
      "kind": "chip",
      "refersTo": "pill-enforce",
      "description": "Semantic CSP disposition chips; red means enforced and amber means report-only.",
      "html": "<span class=\"ds-pill ds-pill-enforce\">Enforced</span> <span class=\"ds-pill ds-pill-report\">Report-only</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:5px;height:20px;padding:0 7px;border-radius:999px;font:500 12px/1 var(--font-sans);white-space:nowrap}.ds-pill::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-pill-enforce{background:var(--enforce-soft);color:var(--enforce)}.ds-pill-report{background:var(--report-soft);color:var(--report)}"
    },
    {
      "name": "Panel Card",
      "kind": "card",
      "refersTo": "panel",
      "description": "Default dashboard container with hairline border and flat surface.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-head\"><h2>Activity</h2><span>Live</span></div><div class=\"ds-panel-body\">Panel content</div></section>",
      "css": ".ds-panel{border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);color:var(--text);overflow:hidden}.ds-panel-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:14px 16px 0}.ds-panel-head h2{margin:0;color:var(--text);font:600 13px/1.5 var(--font-sans)}.ds-panel-head span{color:var(--text-3);font-size:12px}.ds-panel-body{padding:12px 16px 16px;color:var(--text-2);font-size:14px}"
    },
    {
      "name": "Facet Item",
      "kind": "custom",
      "refersTo": "facet-item",
      "description": "Filterable breakdown row with count and categorical progress bar.",
      "html": "<button class=\"ds-facet-item\" type=\"button\" aria-pressed=\"true\" style=\"--pct:68;--fam:var(--fam-script)\"><span class=\"ds-facet-label\"><i></i>script-src</span><span class=\"ds-facet-count\">24</span><span class=\"ds-facet-bar\"><b></b></span></button>",
      "css": ".ds-facet-item{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:4px 10px;width:100%;padding:6px 8px 8px;border:0;border-radius:var(--radius);background:transparent;color:var(--text);font:inherit;text-align:left;cursor:pointer}.ds-facet-item:hover{background:var(--surface-2)}.ds-facet-item[aria-pressed=\"true\"]{background:var(--accent-soft)}.ds-facet-label{display:inline-flex;align-items:center;gap:7px;min-width:0;overflow:hidden;font:12.5px var(--font-mono);text-overflow:ellipsis;white-space:nowrap}.ds-facet-label i{width:8px;height:8px;border-radius:2px;background:var(--fam,var(--fam-other));flex:none}.ds-facet-count{color:var(--accent-text);font-size:12px;font-weight:500;font-variant-numeric:tabular-nums}.ds-facet-bar{grid-column:1/-1;height:3px;border-radius:2px;background:var(--surface-3);overflow:hidden}.ds-facet-bar b{display:block;width:100%;height:100%;border-radius:2px;background:var(--fam,var(--text-3));transform:scaleX(calc(var(--pct,0)/100));transform-origin:left center;transition:transform 400ms var(--ease-out)}"
    },
    {
      "name": "Inspector Drawer",
      "kind": "custom",
      "refersTo": "inspector",
      "description": "Floating right-side report detail drawer with overlay shadow and policy highlighting.",
      "html": "<aside class=\"ds-inspector\"><header><h2><span></span>script-src</h2><button type=\"button\">×</button></header><section><h3>Policy</h3><code>script-src 'self'</code></section></aside>",
      "css": ".ds-inspector{width:min(520px,calc(100vw - 16px));border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);color:var(--text);box-shadow:var(--shadow-pop);overflow:hidden}.ds-inspector header{display:flex;align-items:flex-start;gap:12px;padding:16px 16px 14px;border-bottom:1px solid var(--border)}.ds-inspector h2{flex:1;display:flex;align-items:center;gap:8px;margin:0;font:600 18px/1.5 var(--font-mono);letter-spacing:-.02em}.ds-inspector h2 span{width:10px;height:10px;border-radius:2px;background:var(--fam-script)}.ds-inspector button{width:24px;height:24px;border:1px solid transparent;border-radius:var(--radius-sm);background:transparent;color:var(--text-2);cursor:pointer}.ds-inspector button:hover{background:var(--surface-2);color:var(--text)}.ds-inspector section{padding:18px 16px 24px}.ds-inspector h3{margin:0 0 8px;color:var(--text-2);font:600 12px/1.5 var(--font-sans)}.ds-inspector code{display:block;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--enforce-soft);color:var(--enforce);font:12px/1.55 var(--font-mono)}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Triage Instrument",
    "overview": "CSP Reporting Server is designed as an operating surface for a single developer, not as a promotional dashboard. The built world is restrained, neutral, and precise: quiet backgrounds, hairline panels, small controls, tabular numbers, and code-first detail create the feeling of a trustworthy diagnostic tool that stays out of the way while violations arrive live.\n\nThe system follows the category-standard craft of Linear, Vercel, and GitHub without borrowing their brands. Its personality comes from density control, exact typography, and purposeful data encoding rather than decoration. Light and dark modes are equal citizens: the same semantic tokens are defined in `:root`, mirrored through `prefers-color-scheme`, and overridden by `[data-theme=\"dark\"]` or `[data-theme=\"light\"]`.",
    "keyCharacteristics": [
      "Quiet neutral surfaces with one restrained blue interactive accent.",
      "Red means enforced CSP; amber means report-only; directive colors are data encoding only.",
      "System sans carries UI copy while monospace carries directives, URLs, policies, JSON, and endpoint values.",
      "Hairline borders and tonal layers define structure; shadows are reserved for popovers and the inspector overlay.",
      "Motion is nearly absent except for the authored arriving-report row."
    ],
    "rules": [
      {
        "name": "The Semantic Severity Rule",
        "body": "Red is reserved for enforced, destructive, failed, or policy-hit states; amber is reserved for report-only. Do not use either as decoration.",
        "section": "colors"
      },
      {
        "name": "The Categorical Color Rule",
        "body": "The directive-family palette is only a data encoding system. Do not reuse script/style/media/connect/frame/other colors for brand moments, charts unrelated to directives, or general UI ornament.",
        "section": "colors"
      },
      {
        "name": "The Data Monospace Rule",
        "body": "Directives, URLs, policies, raw JSON, endpoint values, and header snippets stay monospace. Interface copy, labels, and explanations stay in the sans stack.",
        "section": "typography"
      },
      {
        "name": "The Compact Authority Rule",
        "body": "The dashboard earns clarity through tight type sizes and weight, not oversized headings. Keep new UI in the `12px`-`14px` control range unless it is a page heading, empty state, or primary metric.",
        "section": "typography"
      },
      {
        "name": "The Lenses-First Rule",
        "body": "Directive, blocked URL, app, disposition, and search controls are primary navigation. New screens should let every number or item quickly become a filter or drill-down path.",
        "section": "layout"
      },
      {
        "name": "The Dense-But-Breathable Rule",
        "body": "Use compact rows and controls, but preserve `12px-16px` panel padding and clear border separations so the surface reads as an instrument, not a log dump.",
        "section": "layout"
      },
      {
        "name": "The Overlay-Only Shadow Rule",
        "body": "Panels, tables, controls, and facets are flat at rest. Use the pop shadow only for temporary or floating surfaces that overlap other content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the dashboard self-contained: external CSS and JS only, no external fonts, no CDNs, and no decorative remote assets.",
      "Do add new data visualizations with semantic color first: severity for enforcement/report-only, categorical family color only for directive families, neutral gray for all else.",
      "Do route dynamic presentation through CSS custom properties and CSSOM so the strict CSP-compatible model remains intact.",
      "Do preserve light and dark parity whenever adding a reusable color token.",
      "Do keep tables, policies, URLs, and JSON scannable with monospace type, tabular numerals, clipping, and copy affordances."
    ],
    "donts": [
      "Don't introduce gradients, big hero treatments, marketing-card flourishes, or generic SaaS illustrations.",
      "Don't use red, amber, or directive-family colors for decoration or brand expression.",
      "Don't add new shadows to resting panels, tables, or controls.",
      "Don't promote one-off data values or asset-local SVG colors into reusable system tokens.",
      "Don't add inline script or inline style as a design shortcut; the dashboard is built to run under its own strict CSP."
    ]
  }
}
